{
  "name": "crude-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "description": "A Crude Server",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "dev": "nodemon --config nodemon.json",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "pages:build": "npm run build && node scripts/build-pages.mjs",
    "prepush": "npm run lint",
    "prepare": "husky",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@batoanng/types": "^0.5.2",
    "@prisma/client": "6.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "winston": "^3.19.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/hpp": "^0.2.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "20.19.25",
    "@types/supertest": "^7.2.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "prisma": "6.19.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.5"
  }
}
